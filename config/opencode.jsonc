{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "anvil",
  "agents": {
    "build": { "disabled": true },
    "plan": { "disabled": true },
    "general": { "disabled": true },
    "explore": { "disabled": true },
    "anvil": {
      "description": "Anvil's model-agnostic primary coding agent.",
      "mode": "primary",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*.env", "effect": "ask" },
        { "action": "read", "resource": "*.env.*", "effect": "ask" },
        { "action": "read", "resource": "*.env.example", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
        { "action": "shell", "resource": "git clean -f*", "effect": "ask" },
        { "action": "shell", "resource": "git checkout -- *", "effect": "ask" },
        { "action": "shell", "resource": "git restore --worktree*", "effect": "ask" },
        { "action": "shell", "resource": "git push --force*", "effect": "ask" },
        { "action": "shell", "resource": "git push -f*", "effect": "ask" },
        { "action": "shell", "resource": "git branch -D*", "effect": "ask" },
        { "action": "shell", "resource": "git stash drop*", "effect": "ask" },
        { "action": "shell", "resource": "git stash clear*", "effect": "ask" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "anvil-memory", "effect": "allow" },
        { "action": "skill", "resource": "anvil-spark-performance", "effect": "allow" },
        { "action": "skill", "resource": "anvil-delta-lake", "effect": "allow" },
        { "action": "skill", "resource": "anvil-databricks", "effect": "allow" },
        { "action": "skill", "resource": "anvil-data-ingestion", "effect": "allow" },
        { "action": "skill", "resource": "anvil-communication", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "anvil_memory_search", "resource": "*", "effect": "allow" }
      ]
    }
  },
  "mcp": { "servers": {} },
  "plugins": ["./plugins/anvil-core"],
  "references": {
    "anvil-knowledge": {
      "path": "__ANVIL_KNOWLEDGE_PATH__",
      "description": "Authoritative Anvil knowledge documents. Treat source documents as evidence; distilled memory is secondary."
    }
  },
  "compaction": {
    "auto": true,
    "keep": { "tokens": 8000 },
    "buffer": 20000
  },
  "tool_output": {
    "max_lines": 1500,
    "max_bytes": 40000
  },
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/.venv/**",
      "**/venv/**",
      "**/__pycache__/**",
      "**/target/**"
    ]
  }
}
