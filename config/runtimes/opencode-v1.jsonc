{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "anvil",
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true },
    "general": { "disable": true },
    "explore": { "disable": true },
    "anvil": {
      "description": "Anvil's model-agnostic primary coding agent.",
      "mode": "primary",
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "bash": {
          "*": "allow",
          "git reset --hard*": "ask",
          "git clean -f*": "ask",
          "git checkout -- *": "ask",
          "git restore --worktree*": "ask",
          "git push --force*": "ask",
          "git push -f*": "ask",
          "git branch -D*": "ask",
          "git stash drop*": "ask",
          "git stash clear*": "ask"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "question": "allow",
          "anvil_memory_search": "allow",
          "anvil_analytics_search_catalog": "allow",
          "anvil_analytics_describe_table": "allow",
          "anvil_analytics_preview_table": "allow",
          "anvil_analytics_run_query": "allow",
          "anvil_analytics_explain_query": "allow",
          "anvil_analytics_local_coverage": "allow",
          "anvil_analytics_materialize": "ask",
          "anvil_analytics_refresh_metadata": "allow",
          "anvil_analytics_refresh_local": "allow",
          "anvil_analytics_profile_table": "allow",
          "anvil_analytics_lineage": "allow",
          "anvil_analytics_query_history": "allow",
          "anvil_analytics_compare_routes": "allow",
        "task": "deny",
        "skill": {
          "*": "deny",
          "anvil-memory": "allow",
          "anvil-spark-performance": "allow",
          "anvil-delta-lake": "allow",
          "anvil-databricks": "allow",
          "anvil-data-ingestion": "allow",
          "anvil-communication": "allow",
          "anvil-engineering": "allow",
          "anvil-system-design": "allow"
        }
      }
    }
  },
  "mcp": {},
  "plugin": [],
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 4,
    "preserve_recent_tokens": 8000,
    "reserved": 20000
  },
  "tool_output": {
    "max_lines": 1500,
    "max_bytes": 40000
  },
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/.venv/**",
      "**/venv/**",
      "**/__pycache__/**",
      "**/target/**"
    ]
  }
}
