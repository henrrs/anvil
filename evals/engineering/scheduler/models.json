{
  "requirements": {
    "objective": "Implement a bounded local scheduler with separate intent, queue policy and effects",
    "items": [
      {
        "id": "R1",
        "statement": "Job identity and retry budget are immutable and validated",
        "type": "functional",
        "priority": "required",
        "source": {
          "document": "specification.md",
          "section": "Public intent"
        }
      },
      {
        "id": "R2",
        "statement": "Public intent cannot depend on execution or policy",
        "type": "functional",
        "priority": "required",
        "source": {
          "document": "specification.md",
          "section": "Public intent"
        }
      },
      {
        "id": "R3",
        "statement": "Ready work is ordered and capacity bounded",
        "type": "functional",
        "priority": "required",
        "source": {
          "document": "specification.md",
          "section": "Queue policy"
        }
      },
      {
        "id": "R4",
        "statement": "Queue policy does not execute or mutate progress",
        "type": "functional",
        "priority": "required",
        "source": {
          "document": "specification.md",
          "section": "Queue policy"
        }
      },
      {
        "id": "R5",
        "statement": "Two real injected handlers use a minimal callable seam",
        "type": "verification",
        "priority": "required",
        "source": {
          "document": "specification.md",
          "section": "Execution and recovery"
        }
      },
      {
        "id": "R6",
        "statement": "Retry accounting has one owner and completed work is not replayed",
        "type": "verification",
        "priority": "required",
        "source": {
          "document": "specification.md",
          "section": "Execution and recovery"
        }
      },
      {
        "id": "R7",
        "statement": "Failures consume a bounded budget without false acknowledgement",
        "type": "verification",
        "priority": "required",
        "source": {
          "document": "specification.md",
          "section": "Execution and recovery"
        }
      }
    ],
    "constraints": [
      "Offline; no service or compute mutation",
      "Preserve generic ownership across current and future adapters"
    ],
    "risks": [
      "A deterministic replay cannot establish LLM semantic extraction or coding quality"
    ],
    "deferred_scope": [
      "Live providers and production scale"
    ]
  },
  "architecture": {
    "principles": [
      "Intent, physical policy, execution and progress have separate owners"
    ],
    "boundaries": [
      {
        "id": "contract",
        "owns": [
          "job intent"
        ],
        "must_not_know": [
          "handlers"
        ]
      },
      {
        "id": "policy",
        "owns": [
          "ready selection"
        ],
        "must_not_know": [
          "effect implementation"
        ],
        "depends_on": [
          "contract"
        ]
      },
      {
        "id": "executor",
        "owns": [
          "effects",
          "attempt accounting"
        ],
        "must_not_know": [
          "queue strategy"
        ],
        "depends_on": [
          "contract"
        ]
      }
    ],
    "decisions": [
      {
        "id": "D1",
        "context": "Two real handler functions and local-only scheduling",
        "decision": "Inject callables; keep queue selection separate and avoid speculative plugin infrastructure",
        "consequences": [
          "Effects own idempotency",
          "Executor owns attempt budget"
        ],
        "paths": [
          "contracts.py",
          "policy.py",
          "executor.py"
        ]
      }
    ],
    "invariants": [
      {
        "id": "A1",
        "statement": "Job contract is independent of policy and handlers",
        "kind": "forbidden_imports",
        "paths": [
          "contracts.py"
        ],
        "forbidden": [
          "executor",
          "policy"
        ]
      },
      {
        "id": "A2",
        "statement": "Queue policy cannot import execution implementation",
        "kind": "forbidden_imports",
        "paths": [
          "policy.py"
        ],
        "forbidden": [
          "executor"
        ]
      }
    ],
    "unknowns": []
  },
  "work": {
    "milestones": [
      {
