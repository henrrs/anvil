{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "anvil",
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true },
    "general": { "disable": true },
    "explore": { "disable": true },
    "anvil": {
      "mode": "primary",
      "permission": {
        "*": "deny",
        "read": { "*": "allow", "*.env": "ask", "*.env.*": "ask", "*.env.example": "allow" },
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "bash": {
          "*": "allow",
          "git reset --hard*": "ask",
          "git clean -f*": "ask",
          "git checkout -- *": "ask",
          "git restore --worktree*": "ask",
          "git push --force*": "ask",
          "git push -f*": "ask",
          "git branch -D*": "ask",
          "git stash drop*": "ask",
          "git stash clear*": "ask"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "task": "deny",
        "skill": {
          "*": "deny",
          "anvil-memory": "allow",
          "anvil-spark-performance": "allow",
          "anvil-delta-lake": "allow",
          "anvil-databricks": "allow",
          "anvil-data-ingestion": "allow",
          "anvil-communication": "allow",
          "anvil-engineering": "allow",
          "anvil-system-design": "allow"
        }
      }
    }
  },
  "mcp": {},
  "plugin": [],
  "compaction": { "auto": true, "prune": true, "tail_turns": 4, "preserve_recent_tokens": 8000, "reserved": 20000 }
}
